  <script>
    function calculateDoL() {
      const supervision = document.getElementById('chk-supervision').checked;
      const notFree = document.getElementById('chk-not-free').checked;
      const severe = document.getElementById('chk-severe').checked;
      const objecting = document.getElementById('chk-objecting').checked;
      const content = document.getElementById('chk-content').checked;

      // Old Cheshire West Logic
      const cwResult = (supervision && notFree);
      const cwText = cwResult ? 'Definitive Deprivation of Liberty' : 'No DoL';
      const cwColor = cwResult ? '#e53e3e' : '#48bb78';
      
      const cwEl = document.getElementById('cw-result');
      cwEl.textContent = cwText;
      cwEl.style.color = cwColor;

      // New AGNI Logic
      let agniLikelihood = 'Low';
      let agniBg = '#e2e8f0';
      let agniColor = '#4a5568';

      if (severe || objecting) {
        agniLikelihood = 'High (DoLS Authorisation Likely Required)';
        agniBg = '#fed7d7';
        agniColor = '#c53030';
      } else if (content) {
        agniLikelihood = 'Low (Valid consent likely present)';
        agniBg = '#c6f6d5';
        agniColor = '#2f855a';
      } else if (supervision && notFree) {
        agniLikelihood = 'Moderate (Requires deeper contextual assessment)';
        agniBg = '#feebc8';
        agniColor = '#c05621';
      }

      // Update UI
      const agniEl = document.getElementById('agni-result');
      agniEl.textContent = agniLikelihood;
      agniEl.style.backgroundColor = agniBg;
      agniEl.style.color = agniColor;
    }
    
    // Initialize
    calculateDoL();
  </script>

